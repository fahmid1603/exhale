<?xml version="1.0" encoding="utf-8"?>
<!-- The ember swells out of black while the process starts; see splash_ember. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_ember">
    <target android:name="ember">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="1000"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="scaleX"
                    android:valueFrom="0.35"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="1000"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="scaleY"
                    android:valueFrom="0.35"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="glow">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="520"
                android:interpolator="@android:interpolator/linear_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
</animated-vector>
